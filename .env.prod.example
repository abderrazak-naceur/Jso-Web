# Production secrets - never commit the real .env.prod
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_BOOTSTRAP_EMAIL=admin@jso.tn
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-admin-password
PUBLIC_ORIGIN=https://jso.example.com
POSTGRES_USER=jso
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Online payments (shop) - NEVER commit the real .env.prod with these filled.
# Tunisia -> Flouci (TND). Other countries -> Stripe (EUR by default).
# See docs/PAYMENTS.md for how to obtain the keys and configure the webhooks.
Payments__Flouci__AppToken=
Payments__Flouci__AppSecret=
# Required in production to enable Flouci payments (see docs/PAYMENTS.md).
Payments__Flouci__WebhookSecret=
Payments__Stripe__SecretKey=
Payments__Stripe__WebhookSecret=
# TND -> Stripe currency conversion rate (Stripe settles in EUR by default).
# Club responsibility: keep in sync with the real rate. See docs/PAYMENTS.md.
Payments__Stripe__TndToStripeRate=0.30
# REQUIRED in production: return/cancel links are built from this, never the Host header.
Payments__PublicBaseUrl=https://jso.example.com

# Social publishing (optional). Shareable article links use PUBLIC_ORIGIN above.
# To auto-post published news to the club's Facebook Page, create a Meta app,
# grant the pages_manage_posts permission and paste a long-lived Page access
# token here. Leave empty to keep manual sharing only. See docs/SOCIAL.md.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
