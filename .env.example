MSSQL_SA_PASSWORD=ChangeThis_LocalPassword_123!

# Frontend
VITE_API_URL=/api
JSO_API_PROXY_TARGET=http://localhost:8080

# Admin authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_BOOTSTRAP_EMAIL=admin@jso.tn
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-local-password

# Online payments (shop). NEVER commit real values - these are placeholders.
# Tunisia -> Flouci (TND). Other countries -> Stripe (EUR by default).
# See docs/PAYMENTS.md. Bound to the "Payments" configuration section via the
# Payments__* environment variables.
Payments__Flouci__AppToken=
Payments__Flouci__AppSecret=
# Optional shared secret guarding the Flouci webhook (see docs/PAYMENTS.md).
Payments__Flouci__WebhookSecret=
Payments__Stripe__SecretKey=
Payments__Stripe__WebhookSecret=
# TND -> Stripe currency conversion rate (Stripe settles in EUR by default).
# Club responsibility: keep in sync with the real rate. See docs/PAYMENTS.md.
Payments__Stripe__TndToStripeRate=0.30
# Public site base URL used to build the payment return/cancel links.
# REQUIRED in production (the Host header is not trusted there).
Payments__PublicBaseUrl=http://localhost:5173
